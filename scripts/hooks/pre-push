#!/bin/sh
# pre-push 质量闸门：gitee 不支持 GitHub Actions，CI 无法在远端兜底，
# 因此把 typecheck + 单测前移到推送前执行。
#
# 跳过方式（确有急事时）：
#   SKIP_CI=1 git push
#   git push --no-verify
#
# 设计取舍：只跑 typecheck + 单测（约 2 分钟），不跑 build / smoke ——
# 后者依赖 dist 产物与真实 Provider 密钥，属于发布前动作，不适合每次推送。

# 路径断言不受 SKIP_CI 影响：安全防线只能用 git push --no-verify 显式绕过

# 逐个检查被推送的 ref；只有推送分支（非删除分支）时才值得跑
z40=0000000000000000000000000000000000000000
pushed=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$z40" ]; then
    continue # 删除远端分支，无需校验
  fi
  case "$local_ref" in
    refs/tags/*) continue ;; # tag 推送不校验
  esac
  # 路径断言：个人运行时数据禁止入库。
  # .gitignore 挡不住"先提交后加规则"，必须在推送前逐提交检查
  # （树级检查而非 net-diff，add 后又删的提交也会被拦下）。
  if [ "$remote_sha" = "$z40" ]; then
    range_commits=$(git rev-list "$local_sha" --not --remotes)
  else
    range_commits=$(git rev-list "$remote_sha..$local_sha")
  fi
  for commit in $range_commits; do
    hit=$(git ls-tree -r --name-only "$commit" | grep -E '^\.workbuddy/|^\.delta/' || true)
    if [ -n "$hit" ]; then
      echo ""
      echo "[pre-push] ✗ 提交 $commit 含个人运行时数据，推送已中止："
      echo "$hit" | sed 's/^/             /'
      echo "             .workbuddy/ 与 .delta/ 禁止入库，请 git rm --cached 后重试。"
      exit 1
    fi
  done
  pushed=1
done

if [ "$pushed" = "0" ]; then
  exit 0
fi

if [ "${SKIP_CI:-0}" = "1" ]; then
  echo "[pre-push] SKIP_CI=1，跳过类型检查与单测（路径断言已通过）"
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

echo "[pre-push] 1/3 路径断言通过（个人运行时数据未入库）"
echo "[pre-push] 2/3 类型检查 ..."
if ! pnpm -s typecheck; then
  echo ""
  echo "[pre-push] ✗ 类型检查失败，推送已中止。"
  echo "           修复后重试，或 SKIP_CI=1 git push 强制推送。"
  exit 1
fi

echo "[pre-push] 3/3 单测 ..."
if ! pnpm -s test; then
  echo ""
  echo "[pre-push] ✗ 单测失败，推送已中止。"
  echo "           修复后重试，或 SKIP_CI=1 git push 强制推送。"
  exit 1
fi

echo "[pre-push] ✓ 类型检查与单测通过"
exit 0
