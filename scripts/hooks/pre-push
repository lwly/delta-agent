#!/bin/sh
# pre-push 质量闸门：gitee 不支持 GitHub Actions，CI 无法在远端兜底，
# 因此把 typecheck + 单测前移到推送前执行。
#
# 跳过方式（确有急事时）：
#   SKIP_CI=1 git push
#   git push --no-verify
#
# 设计取舍：只跑 typecheck + 单测（约 2 分钟），不跑 build / smoke ——
# 后者依赖 dist 产物与真实 Provider 密钥，属于发布前动作，不适合每次推送。

if [ "${SKIP_CI:-0}" = "1" ]; then
  echo "[pre-push] SKIP_CI=1，跳过类型检查与单测"
  exit 0
fi

# 逐个检查被推送的 ref；只有推送分支（非删除分支）时才值得跑
z40=0000000000000000000000000000000000000000
pushed=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$z40" ]; then
    continue # 删除远端分支，无需校验
  fi
  case "$local_ref" in
    refs/tags/*) continue ;; # tag 推送不校验
  esac
  pushed=1
done

if [ "$pushed" = "0" ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

echo "[pre-push] 1/2 类型检查 ..."
if ! pnpm -s typecheck; then
  echo ""
  echo "[pre-push] ✗ 类型检查失败，推送已中止。"
  echo "           修复后重试，或 SKIP_CI=1 git push 强制推送。"
  exit 1
fi

echo "[pre-push] 2/2 单测 ..."
if ! pnpm -s test; then
  echo ""
  echo "[pre-push] ✗ 单测失败，推送已中止。"
  echo "           修复后重试，或 SKIP_CI=1 git push 强制推送。"
  exit 1
fi

echo "[pre-push] ✓ 类型检查与单测通过"
exit 0
