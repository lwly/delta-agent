{
  "name": "y-zero-agent",
  "private": true,
  "version": "0.1.0",
  "description": "y-zero-agent - AI Coding Agent (CLI core)",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
