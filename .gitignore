node_modules/
dist/
*.tsbuildinfo
.turbo/
coverage/
*.log
.DS_Store
# 测试/工具产生的临时产物（本机删除守卫拦截时无法清理，勿纳入版本库）
.tmp-test/
.tmp-sqlite/
*.timestamp-*.mjs
# 打包产物与中间物（scripts/build-sea.mjs 生成，体积上百 MB）
build/
release/
# 打包中间产物目录（release-win/ 等；release/ 只精确匹配单目录，含 release-dmg*）
release-*/

# 本地运行数据（会话库 / 加密的模型 Key / 评测基线 / 项目注册信息）
# 每个使用者在自己机器上生成，不入库
.delta/

# 编辑器 / 助手工作区（含个人工作记忆，不入库）
.workbuddy/

# 环境变量：密钥只经 env 或 CI secrets 注入，任何 .env 都不入库
.env
.env.*

# F-45 Playwright 失败工件（CI 归档用，不入库）
e2e/test-results/
e2e/playwright-report/
