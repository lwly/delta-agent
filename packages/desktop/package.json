{
  "name": "@delta/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "delta-agent 桌面壳（Electron，方案 B：main 进程进程内托管 @delta/core serve 运行时）",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "rebuild:native:restore": "node scripts/rebuild-native.mjs --restore",
    "dist": "pnpm rebuild:native && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@delta/core": "workspace:*",
    "@delta/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "electron": "^38.0.0-beta.6",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  }
}
